FIREBASE_PROJECT_ID=carrerinfinity-28ab1
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
CAREERINFINITY_DB_PATH=instance/career-infinity.sqlite3
ROLE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional AI questions, answer feedback, and role reviews.
# Keep real keys only in your own ignored .env file. Each clone needs its own key.
# OpenAI defaults:
LLM_API_KEY=
# OPENAI_API_KEY is also accepted for OpenAI.
OPENAI_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# For Groq, set LLM_API_KEY to your own Groq key and replace these values with
# the exact model enabled for your account. Do not use the OpenAI endpoint above.
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=your-enabled-model-name

# Optional live Adzuna job listings. Keep both values in your ignored local .env.
# Each clone needs its own Adzuna credentials. The sample notification feed is used otherwise.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
